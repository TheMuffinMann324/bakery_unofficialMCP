{
  "name": "fivem-unofficial-mcp",
  "version": "0.3.0",
  "description": "Standalone local MCP server and FiveM development bridge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "setup": "node scripts/setup.mjs",
    "check": "node scripts/setup.mjs --check",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "knowledge:sync": "node dist/knowledge-sync.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "minisearch": "7.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "luaparse": "0.3.1",
    "typescript": "5.9.3"
  }
}
